.page { min-height: 100vh; background: var(--cream); padding-top: 16rpx; }

/* 日期选择 */
.dpick { white-space: nowrap; padding: 8rpx 28rpx 4rpx; }
.dp {
  display: inline-block; margin-right: 14rpx; padding: 12rpx 28rpx;
  border-radius: 26rpx; font-size: 25rpx; color: var(--ink-soft);
  background: var(--cream-warm); border: 2rpx solid var(--beige-border);
}
.dp.on { background: var(--sage-dark); border-color: var(--sage-dark); color: #fff; font-weight: 600; }

/* 预览 */
.preview {
  margin: 24rpx 60rpx 0; border-radius: 32rpx; overflow: hidden;
  box-shadow: 0 20rpx 60rpx rgba(58,62,47,.14);
  background: var(--paper); min-height: 640rpx;
  display: flex; align-items: center; justify-content: center;
}
.ph-img { width: 100%; display: block; }
.ph-skeleton { text-align: center; padding: 120rpx 0; }
.sk-bird image { width: 132rpx; height: 132rpx; opacity: .5; }
.sk-tx { font-size: 25rpx; color: var(--ink-mute); margin-top: 22rpx; }

.hint { text-align: center; font-size: 22rpx; color: var(--ink-mute); margin-top: 22rpx; }

/* 操作 */
.acts { display: flex; gap: 16rpx; padding: 32rpx 40rpx 0; }
.act {
  flex: 1; display: flex; align-items: center; justify-content: center; gap: 8rpx;
  padding: 24rpx 0; border-radius: 30rpx; font-size: 26rpx; font-weight: 600;
  line-height: 1; margin: 0;
}
.act::after { border: none; }
.act.ghost { background: var(--cream-warm); border: 2rpx solid var(--beige-border); color: var(--ink-soft); }
.act.accent { background: var(--sage-dark); color: #fff; }
.act.dis, .act[disabled] { opacity: .45; }
.act-ic { width: 30rpx; height: 30rpx; flex-shrink: 0; }

/* 画布藏起来 */
.offscreen { position: fixed; left: -9999px; top: 0; }
