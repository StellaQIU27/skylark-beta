.page { min-height: 100vh; background: var(--cream); padding: 16rpx 0 0; }

.tabs { display: flex; gap: 12rpx; padding: 0 32rpx 18rpx; }
.tb {
  flex: 1; text-align: center; padding: 18rpx 0; border-radius: 24rpx;
  font-size: 25rpx; color: var(--ink-soft);
  background: var(--cream-warm); border: 2rpx solid var(--beige-border);
}
.tb.on { background: var(--sage-dark); border-color: var(--sage-dark); color: #fff; font-weight: 600; }

.flag {
  margin: 0 32rpx 20rpx; padding: 18rpx 24rpx; border-radius: 22rpx;
  font-size: 22rpx; line-height: 1.5;
  background: var(--terracotta-soft); color: #8A4A2E;
}
.flag.on { background: var(--sage-tint); color: var(--sage-darker); }

.empty { text-align: center; color: var(--ink-mute); font-size: 26rpx; padding: 90rpx 0; }

.cc {
  margin: 0 32rpx 20rpx; padding: 26rpx 28rpx;
  background: var(--paper); border: 2rpx solid var(--beige-border);
  border-radius: 30rpx;
}
.cc-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.cc-bird { font-size: 30rpx; font-weight: 700; color: var(--ink); }
.cc-type {
  font-size: 20rpx; font-weight: 600; padding: 5rpx 16rpx; border-radius: 14rpx;
  background: var(--sage-tint); color: var(--sage-dark); flex-shrink: 0;
}
.cc-type.data, .cc-type.idtip { background: var(--paper-dark); color: var(--ink-soft); }
.cc-meta { font-size: 22rpx; color: var(--ink-mute); margin-top: 8rpx; }
.cc-img { width: 100%; height: 380rpx; border-radius: 24rpx; margin-top: 18rpx; background: var(--sage-tint); }
.cc-row { display: flex; gap: 14rpx; font-size: 23rpx; margin-top: 14rpx; }
.cc-k { color: var(--ink-mute); flex-shrink: 0; }
.cc-v { color: var(--ink-soft); flex: 1; }
.cc-text {
  font-size: 26rpx; color: var(--ink); line-height: 1.6; margin-top: 14rpx;
  background: var(--cream-warm); border-radius: 20rpx; padding: 16rpx 20rpx;
  white-space: pre-line; word-break: break-word;
}
.cc-acts { display: flex; gap: 16rpx; align-items: center; margin-top: 20rpx; }
.ca {
  flex: 1; text-align: center; padding: 20rpx 0; border-radius: 26rpx;
  font-size: 26rpx; font-weight: 600;
}
.ca.ghost { background: var(--cream-warm); border: 2rpx solid var(--beige-border); color: var(--ink-soft); }
.ca.accent { background: var(--sage-dark); color: #fff; }
.cc-done { flex: 1.4; font-size: 24rpx; color: var(--sage-dark); font-weight: 600; }
.cc-done.rej { color: var(--terracotta); }
