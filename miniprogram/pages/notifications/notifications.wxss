.page { min-height: 100vh; background: var(--cream); padding: 24rpx 32rpx 0; }
.row { display: flex; gap: 22rpx; padding: 26rpx 16rpx; border-bottom: 2rpx solid var(--beige-border); align-items: flex-start; }
.row.unread { background: var(--cream-warm); border-radius: 24rpx; }
.av { width: 76rpx; height: 76rpx; border-radius: 50%; flex-shrink: 0; background: var(--sage-dark); color: #fff; font-weight: 700; font-size: 30rpx; display: flex; align-items: center; justify-content: center; }
.bd { flex: 1; min-width: 0; }
.tx { font-size: 28rpx; color: var(--ink); line-height: 1.5; }
.tx .b { font-weight: 600; }
.cmt { font-size: 26rpx; color: var(--ink-soft); background: var(--paper); border-radius: 16rpx; padding: 12rpx 20rpx; margin: 10rpx 0; }
.tm { font-size: 21rpx; color: var(--ink-mute); margin-top: 6rpx; }
