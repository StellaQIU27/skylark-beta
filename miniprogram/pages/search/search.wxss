.page { min-height: 100vh; background: var(--cream); padding: 24rpx 32rpx 0; }
.sbox { margin-bottom: 20rpx; }
.sinput { width: 100%; padding: 24rpx 28rpx; font-size: 29rpx; background: #fff; border: 2rpx solid var(--beige-border); border-radius: 32rpx; }
.hint { text-align: center; color: var(--ink-soft); font-size: 28rpx; padding: 80rpx 40rpx; }
.sh { font-size: 24rpx; font-weight: 600; color: var(--ink-soft); margin: 32rpx 0 12rpx; }
.row { display: flex; align-items: center; gap: 22rpx; padding: 20rpx 8rpx; border-bottom: 2rpx solid var(--beige-border); }
.ic { width: 80rpx; height: 80rpx; border-radius: 20rpx; background: var(--sage-tint); overflow: hidden; flex-shrink: 0; }
.ic image { width: 100%; height: 100%; }
.uav { width: 80rpx; height: 80rpx; border-radius: 50%; background: var(--sage-dark); color: #fff; font-weight: 700; font-size: 30rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.bd { flex: 1; min-width: 0; }
.bd .t { font-size: 29rpx; color: var(--ink); font-weight: 500; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.bd .s { font-size: 24rpx; color: var(--ink-soft); margin-top: 4rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
