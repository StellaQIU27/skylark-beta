.page { min-height: 100vh; background: var(--cream); }

/* 品牌头 */
.home-head { padding: 32rpx 40rpx 24rpx; display: flex; align-items: center; justify-content: space-between; }
.hh-row { display: flex; align-items: center; gap: 22rpx; }
.hh-logo { width: 104rpx; height: 104rpx; border-radius: 30rpx; background: var(--paper-dark); flex-shrink: 0; }
.hh-title { font-weight: 700; font-size: 46rpx; color: var(--sage-dark); letter-spacing: -0.5rpx; }
.hh-tag { color: var(--ink-soft); font-size: 24rpx; margin-top: 6rpx; letter-spacing: 2rpx; }
.hh-bell { width: 76rpx; height: 76rpx; display: flex; align-items: center; justify-content: center; position: relative; }
.hh-bell image { width: 44rpx; height: 44rpx; }
.hh-bell.on::after { content: ''; position: absolute; top: 14rpx; right: 14rpx; width: 16rpx; height: 16rpx; border-radius: 50%; background: var(--terracotta); }

/* 搜索 */
.searchbox {
  margin: 0 32rpx 24rpx; display: flex; align-items: center; gap: 14rpx;
  background: #fff; border: 2rpx solid var(--beige-border);
  border-radius: 32rpx; padding: 22rpx 28rpx;
}
.sb-ic { font-size: 26rpx; opacity: .5; }
.sb-tx { color: var(--ink-mute); font-size: 27rpx; }

/* 滚动条 */
.ticker {
  margin: 0 32rpx 24rpx; display: flex; align-items: center; gap: 16rpx;
  background: var(--cream-warm); border: 2rpx solid var(--beige-border);
  border-radius: 28rpx; padding: 22rpx 28rpx;
}
.tk-ic { font-size: 26rpx; }
.tk-tx { flex: 1; font-size: 27rpx; color: var(--ink); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.tk-go { color: var(--ink-mute); font-size: 32rpx; }

/* 三入口卡片 */
.feature-row { display: flex; gap: 18rpx; padding: 0 28rpx; margin-bottom: 28rpx; }
.fcard {
  flex: 1; position: relative; overflow: hidden;
  border-radius: 32rpx; padding: 24rpx 20rpx 0; height: 260rpx;
}
.fc1 { background: #E4ECDC; }
.fc2 { background: #F8E5D7; }
.fc3 { background: #DEE5DE; }
.fcard.soon { filter: grayscale(.35); opacity: .85; }
.fcard .ft { font-weight: 700; font-size: 30rpx; color: var(--ink); position: relative; z-index: 2; }
.fcard .fs { font-size: 21rpx; color: var(--ink-soft); margin-top: 6rpx; position: relative; z-index: 2; line-height: 1.4; }
.fcard .fbg { position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: 170rpx; z-index: 1; }
.soon-badge {
  position: absolute; top: 12rpx; right: 12rpx; z-index: 3;
  background: rgba(58,62,47,.72); color: #fff; font-size: 19rpx;
  padding: 4rpx 14rpx; border-radius: 14rpx;
}

/* 每日小知识 */
.daily {
  display: flex; align-items: center; gap: 20rpx;
  margin: 0 32rpx 24rpx; padding: 22rpx;
  border-radius: 32rpx; border: 2rpx solid rgba(145,122,82,.18);
  background: linear-gradient(135deg, #F5E9D3 0%, #E7EEDB 100%);
}
.dk-illu { width: 190rpx; height: 190rpx; flex-shrink: 0; }
.dk-body { flex: 1; min-width: 0; }
.dk-kicker { font-size: 22rpx; font-weight: 700; color: var(--sage-dark); }
.dk-title { font-size: 29rpx; font-weight: 700; color: var(--ink); margin-top: 10rpx; line-height: 1.35; }
.dk-sub { font-size: 23rpx; color: var(--ink-soft); margin-top: 8rpx; line-height: 1.45;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

/* 筛选 */
.filter { white-space: nowrap; padding: 0 32rpx 20rpx; }
.ff {
  display: inline-block; margin-right: 14rpx; padding: 12rpx 28rpx;
  border-radius: 26rpx; background: var(--cream-warm);
  border: 2rpx solid var(--beige-border); font-size: 25rpx; color: var(--ink-soft);
}
.ff.on { background: var(--sage-dark); color: #fff; border-color: var(--sage-dark); font-weight: 600; }

/* 双列瀑布 */
.feed-grid { display: flex; gap: 20rpx; padding: 0 24rpx; align-items: flex-start; }
.fg-col { flex: 1; min-width: 0; }
.xcard {
  background: var(--paper); border: 2rpx solid var(--beige-border);
  border-radius: 28rpx; overflow: hidden; margin-bottom: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(107,122,76,.07);
}
.xc-cover image { width: 100%; display: block; }
.xc-cover { position: relative; }
.xc-cover.text {
  padding: 32rpx 26rpx; min-height: 150rpx; font-size: 30rpx; font-weight: 600;
  color: var(--ink); line-height: 1.45;
  background: linear-gradient(135deg, #F3EEDE 0%, #E9EFE0 100%);
  display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden;
}
.xc-cover.text.wild { background: linear-gradient(135deg, #E6EEF1 0%, #DEE9D2 100%); }
.xc-count {
  position: absolute; right: 14rpx; bottom: 14rpx;
  background: rgba(58,62,47,.6); color: #fff; font-size: 21rpx;
  padding: 2rpx 14rpx; border-radius: 16rpx;
}
.xc-body { padding: 18rpx 22rpx 22rpx; }
.xc-title { font-size: 27rpx; color: var(--ink); line-height: 1.4; font-weight: 500;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.xc-foot { display: flex; justify-content: space-between; align-items: center; margin-top: 16rpx; }
.xc-au { display: flex; align-items: center; gap: 10rpx; min-width: 0; }
.xa-av {
  width: 40rpx; height: 40rpx; border-radius: 50%; flex-shrink: 0;
  background: var(--sage-dark); color: #fff; font-size: 20rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.xa-nm { font-size: 23rpx; color: var(--ink-soft); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.xc-like { font-size: 23rpx; color: var(--ink-mute); flex-shrink: 0; }
.xc-like.on { color: var(--terracotta); }

/* 单列信息流（护理问答） */
.ifeed { padding: 0 32rpx; }
.ifeed-card {
  display: flex; gap: 22rpx; align-items: flex-start;
  background: var(--paper); border: 2rpx solid var(--beige-border);
  border-radius: 28rpx; padding: 26rpx 28rpx; margin-bottom: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(107,122,76,.06);
}
.if-main { flex: 1; min-width: 0; }
.if-title { font-size: 30rpx; font-weight: 600; color: var(--ink); line-height: 1.45;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.if-body { font-size: 27rpx; color: var(--ink-soft); line-height: 1.5; margin-top: 8rpx;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.if-foot { display: flex; justify-content: space-between; align-items: center; margin-top: 18rpx; font-size: 24rpx; color: var(--ink-soft); }
.if-meta { color: var(--ink-mute); }
.if-thumb { width: 150rpx; height: 150rpx; border-radius: 20rpx; flex-shrink: 0; }
.ans { display: inline-block; font-size: 21rpx; font-weight: 600; padding: 2rpx 14rpx; border-radius: 12rpx; margin-right: 12rpx; }
.ans.wait { background: var(--terracotta-soft); color: var(--terracotta); }
.ans.done { background: var(--sage-tint); color: var(--sage-dark); }

/* 悬浮发帖 */
.fab {
  position: fixed; right: 40rpx; bottom: calc(60rpx + env(safe-area-inset-bottom));
  width: 108rpx; height: 108rpx; border-radius: 50%;
  background: var(--sage-dark); color: #fff; font-size: 60rpx; font-weight: 300;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 10rpx 30rpx rgba(107,122,76,.32); z-index: 50;
}

/* 弹窗 */
.mask { position: fixed; inset: 0; background: rgba(30,32,24,.45); z-index: 300; opacity: 0; pointer-events: none; transition: opacity .25s; }
.mask.show { opacity: 1; pointer-events: auto; }
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 301;
  background: var(--cream); border-radius: 56rpx 56rpx 0 0;
  padding: 32rpx 40rpx calc(56rpx + env(safe-area-inset-bottom));
  transform: translateY(100%); transition: transform .3s cubic-bezier(.2,.9,.3,1);
  max-height: 80vh; overflow-y: auto;
}
.sheet.show { transform: translateY(0); }
.sh-handle { width: 72rpx; height: 8rpx; border-radius: 4rpx; background: var(--paper-dark); margin: 0 auto 24rpx; }
.dks-kicker { font-size: 24rpx; font-weight: 700; color: var(--sage-dark); }
.dks-title { font-size: 38rpx; font-weight: 700; margin: 12rpx 0 20rpx; }
.dks-body { font-size: 30rpx; color: var(--ink); line-height: 1.7; }
.dks-src { font-size: 24rpx; color: var(--ink-soft); margin-top: 28rpx; }
.sh-actions { display: flex; gap: 20rpx; margin-top: 32rpx; }
.sh-actions .btn { flex: 1; }
