<view class="page">
  <!-- 品牌头 -->
  <view class="home-head">
    <view class="hh-row">
      <image class="hh-logo" src="/images/skylark-logo.png" mode="aspectFill"/>
      <view>
        <view class="hh-title">Skylark<text class="hh-cn">· 雀跃</text></view>
        <view class="hh-tag">{{comm ? '记录 · 分享 · 发现 · 守护' : '记录 · 陪伴 · 守护'}}</view>
      </view>
    </view>
    <view class="hh-bell {{unread>0?'on':''}}" wx:if="{{comm}}" bindtap="goNotifications">
      <image src="/images/icon-bell.png" mode="aspectFit"/>
    </view>
  </view>

  <!-- 搜索 -->
  <view class="searchbox" bindtap="goSearch">
    <image class="sb-ic" src="/images/ic-search.png" mode="aspectFit"/>
    <text class="sb-tx">{{comm ? '搜索鸟种 / 帖子 / 用户' : '搜索鸟种'}}</text>
  </view>

  <!-- 滚动通知条 -->
  <view class="ticker" wx:if="{{ticker}}" bindtap="tickerTap">
    <image class="tk-ic" src="/images/icon-bell.png" mode="aspectFit"/>
    <text class="tk-tx">{{ticker.text}}</text>
    <text class="tk-go">›</text>
  </view>

  <!-- 三个入口 -->
  <view class="feature-row">
    <view class="fcard fc1" bindtap="goRecords">
      <view class="fc-fade"></view>
      <view class="ft">我的爱鸟</view>
      <view class="fs">记录成长与健康</view>
      <view class="fi">›</view>
    </view>
    <view class="fcard fc2" bindtap="{{comm ? 'goCommunity' : 'goGuide'}}">
      <view class="fc-fade"></view>
      <view class="ft">{{comm ? '社区' : '鸟种图鉴'}}</view>
      <view class="fs">{{comm ? '交流经验与心得' : '认识身边的鸟'}}</view>
      <view class="fi">›</view>
    </view>
    <view class="fcard fc3 soon" bindtap="soonTip">
      <view class="fc-fade"></view>
      <view class="soon-badge">待开发</view>
      <view class="ft">识鸟</view>
      <view class="fs">拍照识别鸟种</view>
      <view class="fi">›</view>
    </view>
  </view>

  <!-- 记录版：每日养鸟小知识 -->
  <view class="daily" wx:if="{{!comm && knowledge}}" bindtap="openKnowledge">
    <image class="dk-illu" src="/images/daily-knowledge-bird.png" mode="aspectFit"/>
    <view class="dk-content">
      <view class="dk-top">
        <view class="dk-kicker">每日养鸟小知识</view>
        <view class="dk-date">{{today}}</view>
      </view>
      <view class="dk-title">{{knowledge.title}}</view>
      <view class="dk-sub">{{knowledge.body}}</view>
      <view class="dk-actions">
        <view class="dk-tag">{{knowledge.tag}}</view>
        <view class="dk-go">查看全文 ›</view>
      </view>
    </view>
  </view>

  <!-- 记录版：今日提醒 -->
  <view class="quick-rec" wx:if="{{!comm}}" bindtap="goRecords">
    <view class="qr-main">
      <view class="qr-t">今天的记录</view>
      <view class="qr-s">{{recHint}}</view>
    </view>
    <view class="qr-go">去记录 ›</view>
  </view>

  <block wx:if="{{comm}}">
  <!-- 频道筛选 -->
  <view class="section-head">
    <view class="h">最新动态</view>
  </view>
  <scroll-view class="filter" scroll-x>
    <view class="ff {{filter==='all'?'on':''}}" data-f="all" bindtap="setFilter">全部</view>
    <view class="ff {{filter==='daily'?'on':''}}" data-f="daily" bindtap="setFilter">养鸟日常</view>
    <view class="ff {{filter==='carehelp'?'on':''}}" data-f="carehelp" bindtap="setFilter">护理问答</view>
    <view class="ff {{filter==='wild'?'on':''}}" data-f="wild" bindtap="setFilter">观鸟交流</view>
  </scroll-view>

  <!-- 空态 -->
  <view class="empty-card" wx:if="{{!list.length && !loading}}">
    <view class="et">还没有动态</view>
    <view class="es">点下方「＋」发第一条，\n和鸟友们交流吧。</view>
  </view>

  <!-- 护理问答：单列信息流 -->
  <view class="ifeed" wx:if="{{filter==='carehelp' && list.length}}">
    <view class="ifeed-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="openPost">
      <view class="if-main">
        <view class="if-title">
          <text wx:if="{{item.isHelp}}" class="ans {{item.answered?'done':'wait'}}">{{item.answered?'已回答':'待回答'}}</text>{{item.title||item.body}}
        </view>
        <view class="if-body" wx:if="{{item.title && item.body}}">{{item.body}}</view>
        <view class="if-foot">
          <text class="if-au">{{item.author}}</text>
          <text class="if-meta">赞 {{item.likes}} · 回复 {{item.commentCount}}</text>
        </view>
      </view>
      <image wx:if="{{item.photo}}" class="if-thumb" src="{{item.photo}}" mode="aspectFill"/>
    </view>
  </view>

  <!-- 其它：双列瀑布 -->
  <view class="feed-grid" wx:if="{{filter!=='carehelp' && list.length}}">
    <view class="fg-col">
      <view class="xcard" wx:for="{{colA}}" wx:key="id" data-id="{{item.id}}" bindtap="openPost">
        <view class="xc-cover" wx:if="{{item.photo}}">
          <image src="{{item.photo}}" mode="widthFix"/>
          <text class="xc-count" wx:if="{{item.photoCount>1}}">{{item.photoCount}}图</text>
        </view>
        <view class="xc-cover text {{item.domain}}" wx:else>{{item.title||item.body||'分享一刻'}}</view>
        <view class="xc-body">
          <view class="xc-title" wx:if="{{item.photo && (item.title||item.body)}}">{{item.title||item.body}}</view>
          <view class="xc-foot">
            <view class="xc-au"><view class="xa-av">{{item.initial}}</view><text class="xa-nm">{{item.author}}</text></view>
            <view class="xc-like {{item.likedByMe?'on':''}}"><image class="xc-ic" src="{{item.likedByMe?'/images/ic-like-on.png':'/images/ic-like.png'}}" mode="aspectFit"/>{{item.likes}}</view>
          </view>
        </view>
      </view>
    </view>
    <view class="fg-col">
      <view class="xcard" wx:for="{{colB}}" wx:key="id" data-id="{{item.id}}" bindtap="openPost">
        <view class="xc-cover" wx:if="{{item.photo}}">
          <image src="{{item.photo}}" mode="widthFix"/>
          <text class="xc-count" wx:if="{{item.photoCount>1}}">{{item.photoCount}}图</text>
        </view>
        <view class="xc-cover text {{item.domain}}" wx:else>{{item.title||item.body||'分享一刻'}}</view>
        <view class="xc-body">
          <view class="xc-title" wx:if="{{item.photo && (item.title||item.body)}}">{{item.title||item.body}}</view>
          <view class="xc-foot">
            <view class="xc-au"><view class="xa-av">{{item.initial}}</view><text class="xa-nm">{{item.author}}</text></view>
            <view class="xc-like {{item.likedByMe?'on':''}}"><image class="xc-ic" src="{{item.likedByMe?'/images/ic-like-on.png':'/images/ic-like.png'}}" mode="aspectFit"/>{{item.likes}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>
  </block>

  <view class="page-pad"></view>
</view>

<!-- 发帖悬浮按钮 -->
<view class="fab" wx:if="{{comm}}" bindtap="goCompose">＋</view>

<!-- 每日小知识弹窗 -->
<view class="mask {{showKnow?'show':''}}" bindtap="closeKnow"></view>
<view class="sheet {{showKnow?'show':''}}">
  <view class="sh-handle"></view>
  <view class="dks-kicker">每日养鸟小知识 · {{knowledge.tag}}</view>
  <view class="dks-title">{{knowledge.title}}</view>
  <view class="dks-body">{{knowledge.body}}</view>
  <view class="dks-src">小知识仅供参考，鸟宝出现异常请及时就医</view>
  <view class="sh-actions">
    <view class="btn ghost" bindtap="closeKnow">关闭</view>
    <view class="btn accent" wx:if="{{comm}}" bindtap="knowGo">去讨论</view>
  </view>
</view>
