.page { min-height: 100vh; background: var(--cream); padding: 24rpx 32rpx 0; }
.card { display: flex; align-items: center; gap: 22rpx; background: var(--cream-warm); border: 2rpx solid var(--beige-border); border-radius: 28rpx; padding: 24rpx; margin-bottom: 20rpx; }
.ph { width: 130rpx; height: 130rpx; border-radius: 20rpx; flex-shrink: 0; }
.bd { flex: 1; min-width: 0; }
.bd .t { font-size: 29rpx; font-weight: 500; color: var(--ink); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.bd .s { font-size: 23rpx; color: var(--ink-soft); margin-top: 8rpx; }
.del { color: var(--terracotta); font-size: 25rpx; padding: 0 12rpx; flex-shrink: 0; }
