.page { min-height: 100vh; background: var(--cream); padding: 24rpx 32rpx 0; }
.sum { font-size: 25rpx; color: var(--ink-soft); margin-bottom: 20rpx; }
.ag { background: var(--cream-warm); border: 2rpx solid var(--beige-border); border-radius: 32rpx; padding: 24rpx; margin-bottom: 24rpx; }
.ag-head { display: flex; align-items: center; gap: 16rpx; margin-bottom: 18rpx; }
.ag-date { font-size: 27rpx; font-weight: 700; }
.ag-pet { font-size: 22rpx; font-weight: 600; color: var(--sage-dark); background: var(--sage-tint); padding: 4rpx 16rpx; border-radius: 16rpx; }
.ag-n { margin-left: auto; font-size: 22rpx; color: var(--ink-soft); }
.ag-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; }
.ag-grid image { width: 100%; height: 200rpx; border-radius: 20rpx; }
.ag-note { margin-top: 18rpx; padding-top: 16rpx; border-top: 2rpx dashed var(--beige-border); font-size: 25rpx; color: var(--ink); line-height: 1.5; }
