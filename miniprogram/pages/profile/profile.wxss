.page { min-height: 100vh; background: var(--cream); }

/* 顶部 */
.prof-top { background: linear-gradient(180deg, #E4EBDA 0%, transparent 80%); padding: 56rpx 40rpx 28rpx; position: relative; }
.prof-actions { position: absolute; top: 40rpx; right: 32rpx; display: flex; gap: 12rpx; }
.pa-btn {
  width: 72rpx; height: 72rpx; border-radius: 24rpx; position: relative;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; color: var(--ink-soft);
}
.pa-btn.on::after { content: ''; position: absolute; top: 10rpx; right: 10rpx; width: 14rpx; height: 14rpx; border-radius: 50%; background: var(--terracotta); }
.prof-me { display: flex; align-items: center; gap: 24rpx; }
.av {
  width: 120rpx; height: 120rpx; min-width: 120rpx; border-radius: 50%;
  background: var(--sage-dark); color: #fff; font-size: 48rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  position: relative; border: 4rpx solid #fff; flex-shrink: 0;
  box-shadow: 0 8rpx 20rpx rgba(107,122,76,.1);
}
.av image { width: 100%; height: 100%; border-radius: 50%; }
.av-cam {
  position: absolute; bottom: -4rpx; right: -4rpx;
  width: 44rpx; height: 44rpx; border-radius: 50%;
  background: var(--sage-dark); color: #fff; font-size: 20rpx;
  display: flex; align-items: center; justify-content: center;
  border: 4rpx solid var(--cream);
}
.pm-info { flex: 1; min-width: 0; }
.n { font-weight: 700; font-size: 36rpx; display: flex; align-items: center; gap: 12rpx; }
.lv { font-size: 20rpx; font-weight: 600; color: var(--sage-dark); background: var(--sage-tint); padding: 4rpx 14rpx; border-radius: 14rpx; }
.s { font-size: 25rpx; color: var(--ink-soft); margin-top: 8rpx; display: flex; gap: 14rpx; }
.s .dot { color: var(--ink-mute); }

/* 四格 */
.stats-card {
  display: flex; margin: 0 32rpx 24rpx; padding: 28rpx 12rpx;
  background: var(--cream-warm); border: 2rpx solid var(--beige-border); border-radius: 36rpx;
}
.st { flex: 1; text-align: center; }
.si { width: 52rpx; height: 52rpx; margin: 0 auto 10rpx; display: block; }
.sv { font-weight: 700; font-size: 36rpx; color: var(--ink); }
.sl { font-size: 21rpx; color: var(--ink-soft); margin-top: 4rpx; }

/* 连续记录 */
.streak-card {
  margin: 0 32rpx 24rpx; padding: 28rpx 32rpx;
  background: var(--cream-warm); border: 2rpx solid var(--beige-border); border-radius: 36rpx;
}
.streak-card .sh { display: flex; align-items: center; justify-content: space-between; }
.streak-card .t { font-weight: 700; font-size: 30rpx; }
.streak-card .t .b { color: var(--sage-dark); font-size: 38rpx; }
.streak-card .sub { font-size: 23rpx; color: var(--ink-soft); margin-top: 8rpx; }
.streak-dots { display: flex; gap: 10rpx; margin-top: 20rpx; flex-wrap: wrap; }
.dot {
  width: 52rpx; height: 52rpx; border-radius: 50%;
  background: var(--sage-tint); color: var(--sage-dark);
  font-size: 22rpx; display: flex; align-items: center; justify-content: center;
}
.dot.today { background: var(--sage-dark); color: #fff; font-weight: 700; }

/* 菜单 */
.menu-card {
  margin: 0 32rpx; padding: 8rpx 0;
  background: var(--cream-warm); border: 2rpx solid var(--beige-border); border-radius: 36rpx;
}
.menu-row {
  display: flex; align-items: center; gap: 22rpx;
  padding: 28rpx 32rpx; border-bottom: 2rpx solid var(--beige-border);
}
.menu-row:last-child { border-bottom: none; }
.mi {
  width: 56rpx; height: 56rpx; border-radius: 18rpx; flex-shrink: 0;
  background: var(--sage-tint); color: var(--sage-dark); font-size: 26rpx;
  display: flex; align-items: center; justify-content: center;
}
.ml { flex: 1; font-size: 29rpx; color: var(--ink); }
.mc { color: var(--ink-mute); font-size: 25rpx; }

/* 弹窗 */
.mask { position: fixed; inset: 0; background: rgba(30,32,24,.45); z-index: 300; opacity: 0; pointer-events: none; transition: opacity .25s; }
.mask.show { opacity: 1; pointer-events: auto; }
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 301;
  background: var(--cream); border-radius: 56rpx 56rpx 0 0;
  padding: 32rpx 40rpx calc(56rpx + env(safe-area-inset-bottom));
  transform: translateY(100%); transition: transform .3s cubic-bezier(.2,.9,.3,1);
  max-height: 82vh; overflow-y: auto;
}
.sheet.show { transform: translateY(0); }
.sh-handle { width: 72rpx; height: 8rpx; border-radius: 4rpx; background: var(--paper-dark); margin: 0 auto 24rpx; }
.sh-title { font-weight: 700; font-size: 36rpx; margin-bottom: 24rpx; }
.sh-actions { display: flex; gap: 20rpx; margin-top: 28rpx; }
.sh-actions .btn { flex: 1; }
.ap-wrap { position: relative; width: 180rpx; margin: 12rpx auto 10rpx; }
.ap-img {
  width: 180rpx; height: 180rpx; border-radius: 50%; overflow: hidden;
  background: var(--sage-dark); color: #fff; font-size: 64rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.ap-img image { width: 100%; height: 100%; }
.ap-cam {
  position: absolute; bottom: 4rpx; right: 4rpx;
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: var(--sage-dark); color: #fff; font-size: 24rpx;
  display: flex; align-items: center; justify-content: center; border: 4rpx solid var(--cream);
}
.ap-hint { text-align: center; font-size: 22rpx; color: var(--ink-soft); margin-bottom: 28rpx; }
.fld-l { font-size: 22rpx; color: var(--ink-mute); font-weight: 600; margin-bottom: 12rpx; }
.ipt {
  width: 100%; padding: 24rpx 28rpx; font-size: 29rpx;
  background: var(--cream-warm); border: 2rpx solid var(--beige-border); border-radius: 24rpx;
}
.bk-tip { font-size: 26rpx; color: var(--ink-soft); line-height: 1.7; margin-bottom: 28rpx; }
.bk-tip.sm { font-size: 24rpx; margin-bottom: 20rpx; }
.bk-div {
  font-size: 24rpx; color: var(--ink-mute); font-weight: 600;
  margin: 32rpx 0 16rpx; padding-top: 28rpx; border-top: 2rpx solid var(--beige-border);
}
.link-btn { text-align: center; font-size: 25rpx; color: var(--sage-dark); padding: 12rpx; }
.paste-box {
  width: 100%; height: 300rpx; padding: 24rpx; font-size: 24rpx; line-height: 1.5;
  background: var(--cream-warm); border: 2rpx solid var(--beige-border); border-radius: 24rpx;
}
