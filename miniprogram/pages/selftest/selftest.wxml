<view class="page">
  <view class="hd">雀跃 · 环境自检</view>
  <view class="sub">检查云开发配置是否就绪</view>

  <view class="card">
    <view class="row"><text class="k">云环境</text><text class="v {{envOk?'ok':'bad'}}">{{envMsg}}</text></view>
    <view class="row"><text class="k">用户身份</text><text class="v {{openidOk?'ok':'bad'}}">{{openidOk?'已识别':openidMsg}}</text></view>
  </view>
  <view class="oid-box" wx:if="{{openidOk}}" bindtap="copyOpenid">
    <view class="oid-l">我的 openid（点击复制）</view>
    <view class="oid-v">{{openid}}</view>
    <view class="oid-t">当前环境：{{isDevtool ? '开发者工具（与真机不同）' : '真机'}}</view>
  </view>

  <view class="sec">数据库集合（{{okCount}}/{{total}} 就绪）</view>
  <view class="card">
    <view class="row" wx:for="{{cols}}" wx:key="name">
      <text class="k">{{item.name}}</text>
      <text class="v {{item.ok?'ok':'bad'}}">{{item.msg}}</text>
    </view>
  </view>

  <view class="sec" wx:if="{{errs.length}}">需要处理</view>
  <view class="errbox" wx:if="{{errs.length}}">
    <view class="err" wx:for="{{errs}}" wx:key="*this">• {{item}}</view>
  </view>
  <view class="allok" wx:if="{{done && !errs.length}}">✓ 全部就绪，可以正常使用了</view>

  <view class="btn" bindtap="run">重新检测</view>
  <view class="page-pad"></view>
</view>
