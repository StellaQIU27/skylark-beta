<view class="page">
  <view class="menu-card">
    <view class="menu-row" bindtap="editProfile"><text class="ml">个人资料</text><text class="mc">{{user.name}} ›</text></view>
    <view class="menu-row" bindtap="goNotif"><text class="ml">通知提醒</text><text class="mc">›</text></view>
    <view class="menu-row" bindtap="soon"><text class="ml">隐私设置</text><text class="mc">›</text></view>
    <view class="menu-row" bindtap="goHelp"><text class="ml">帮助与反馈</text><text class="mc">›</text></view>
    <view class="menu-row" wx:if="{{isAdmin}}" bindtap="goSelfTest"><text class="ml">环境自检</text><text class="mc">›</text></view>
    <view class="menu-row" wx:if="{{isAdmin}}" bindtap="goDashboard"><text class="ml">内测数据</text><text class="mc">›</text></view>
    <view class="menu-row"><text class="ml">关于 Skylark · 雀跃</text><text class="mc">{{version}}</text></view>
  </view>
  <view class="tip">你的爱鸟与记录已随微信号自动同步到云端，换设备登录同一微信即可恢复。</view>
  <view class="danger" bindtap="clearLocal">清除本地数据</view>
</view>

<!-- 编辑资料 -->
<view class="mask {{showEdit?'show':''}}" bindtap="closeEdit"></view>
<view class="sheet {{showEdit?'show':''}}">
  <view class="sh-handle"></view>
  <view class="sh-title">编辑资料</view>
  <view class="ap-wrap" bindtap="pickAvatar">
    <view class="ap-img">
      <image wx:if="{{tmpAvatar}}" src="{{tmpAvatar}}" mode="aspectFill"/>
      <text wx:else>{{initial}}</text>
    </view>
    <view class="ap-cam">📷</view>
  </view>
  <view class="ap-hint">点击上传头像</view>
  <view class="fld-l">昵称</view>
  <input class="ipt" placeholder="给自己起个昵称" value="{{tmpName}}" bindinput="onName" maxlength="16"/>
  <view class="sh-actions">
    <view class="btn ghost" bindtap="closeEdit">取消</view>
    <view class="btn accent" bindtap="saveProfile">保存</view>
  </view>
</view>
