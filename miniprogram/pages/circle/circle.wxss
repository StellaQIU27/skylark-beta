.page { min-height: 100vh; background: var(--cream); padding-top: 12rpx; }

/* 圈子头 */
.circle-hero {
  display: flex; align-items: center; gap: 26rpx;
  margin: 8rpx 32rpx 0; padding: 32rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #EAF0DF 0%, #F3ECDC 100%);
}
.circle-hero.wild { background: linear-gradient(135deg, #E3ECEF 0%, #DEE9D2 100%); }
.ch-logo { width: 128rpx; height: 128rpx; border-radius: 32rpx; flex-shrink: 0; }
.ch-info { flex: 1; min-width: 0; }
.ch-name { font-weight: 700; font-size: 38rpx; color: var(--ink); display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }
.beta-tag { font-size: 20rpx; font-weight: 600; color: var(--terracotta); background: var(--terracotta-soft); padding: 4rpx 14rpx; border-radius: 14rpx; }
.ch-blurb { font-size: 24rpx; color: var(--ink-soft); margin-top: 10rpx; line-height: 1.5; }
.ch-row { display: flex; align-items: center; justify-content: space-between; margin-top: 24rpx; gap: 16rpx; }
.ch-members { font-size: 24rpx; color: var(--ink-soft); }
.ch-members .b { color: var(--sage-dark); font-size: 30rpx; font-weight: 700; }
.ch-join {
  padding: 14rpx 32rpx; border-radius: 36rpx; flex-shrink: 0;
  background: var(--sage-dark); color: #fff; font-size: 25rpx; font-weight: 600;
}
.ch-join.on { background: var(--paper-dark); color: var(--ink-soft); }

/* section head */
.section-head { padding: 28rpx 40rpx 16rpx; display: flex; align-items: center; justify-content: space-between; }
.section-head .h { font-weight: 700; font-size: 34rpx; }
.link-btn { font-size: 25rpx; color: var(--sage-dark); font-weight: 500; }
.post-btn {
  display: flex; align-items: center; gap: 8rpx;
  padding: 12rpx 24rpx; border-radius: 24rpx;
  background: var(--paper-dark); color: var(--ink-soft); font-size: 24rpx; font-weight: 500;
}

/* 置顶卡 */
.pin-card {
  position: relative; margin: 0 32rpx 20rpx; padding: 28rpx;
  background: var(--paper); border: 2rpx solid var(--terracotta-soft);
  border-radius: 32rpx;
}
.pin-badge {
  position: absolute; top: 24rpx; right: 28rpx;
  background: var(--terracotta); color: #fff; font-size: 20rpx; font-weight: 600;
  padding: 4rpx 16rpx; border-radius: 14rpx;
}
.pin-head { display: flex; align-items: center; gap: 16rpx; margin-bottom: 16rpx; }
.pin-av {
  width: 60rpx; height: 60rpx; border-radius: 50%; flex-shrink: 0;
  background: var(--terracotta); color: #fff; font-weight: 700; font-size: 26rpx;
  display: flex; align-items: center; justify-content: center;
}
.pin-author { font-weight: 600; font-size: 26rpx; }
.pin-time { font-size: 21rpx; color: var(--ink-mute); }
.pin-title { font-weight: 700; font-size: 32rpx; color: var(--ink); line-height: 1.4; margin-bottom: 10rpx; }
.pin-body {
  font-size: 27rpx; color: var(--ink-soft); line-height: 1.6;
  display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
}
.pin-src {
  font-size: 21rpx; color: var(--ink-soft); margin-top: 18rpx;
  padding-top: 16rpx; border-top: 2rpx solid var(--beige-border); line-height: 1.5;
}

/* 双列瀑布 */
.feed-grid { display: flex; gap: 20rpx; padding: 0 24rpx; align-items: flex-start; }
.fg-col { flex: 1; min-width: 0; }
.xcard {
  background: var(--paper); border: 2rpx solid var(--beige-border);
  border-radius: 28rpx; overflow: hidden; margin-bottom: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(107,122,76,.07);
}
.xc-cover { position: relative; }
.xc-cover image { width: 100%; display: block; max-height: 520rpx; }
.xc-cover.text {
  padding: 32rpx 26rpx; min-height: 150rpx; font-size: 30rpx; font-weight: 600;
  color: var(--ink); line-height: 1.45;
  background: linear-gradient(135deg, #F3EEDE 0%, #E9EFE0 100%);
  display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden;
}
.xc-cover.text.wild { background: linear-gradient(135deg, #E6EEF1 0%, #DEE9D2 100%); }
.xc-count { position: absolute; right: 14rpx; bottom: 14rpx; background: rgba(58,62,47,.6); color: #fff; font-size: 21rpx; padding: 2rpx 14rpx; border-radius: 16rpx; }
.xc-body { padding: 18rpx 22rpx 22rpx; }
.xc-title { font-size: 27rpx; color: var(--ink); line-height: 1.4; font-weight: 500;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.xc-foot { display: flex; justify-content: space-between; align-items: center; margin-top: 16rpx; }
.xc-au { display: flex; align-items: center; gap: 10rpx; min-width: 0; }
.xa-av { width: 40rpx; height: 40rpx; border-radius: 50%; flex-shrink: 0; background: var(--sage-dark); color: #fff; font-size: 20rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.xa-nm { font-size: 23rpx; color: var(--ink-soft); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.xc-like { font-size: 23rpx; color: var(--ink-mute); flex-shrink: 0; }
.xc-like.on { color: var(--terracotta); }

/* 单列信息流 */
.ifeed { padding: 0 32rpx; }
.ifeed-card {
  display: flex; gap: 22rpx; align-items: flex-start;
  background: var(--paper); border: 2rpx solid var(--beige-border);
  border-radius: 28rpx; padding: 26rpx 28rpx; margin-bottom: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(107,122,76,.06);
}
.if-main { flex: 1; min-width: 0; }
.if-title { font-size: 30rpx; font-weight: 600; color: var(--ink); line-height: 1.45;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.if-body { font-size: 27rpx; color: var(--ink-soft); line-height: 1.5; margin-top: 8rpx;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.if-foot { display: flex; justify-content: space-between; align-items: center; margin-top: 18rpx; font-size: 24rpx; color: var(--ink-soft); }
.if-meta { color: var(--ink-mute); }
.if-thumb { width: 150rpx; height: 150rpx; border-radius: 20rpx; flex-shrink: 0; }
.ans { display: inline-block; font-size: 21rpx; font-weight: 600; padding: 2rpx 14rpx; border-radius: 12rpx; margin-right: 12rpx; }
.ans.wait { background: var(--terracotta-soft); color: var(--terracotta); }
.ans.done { background: var(--sage-tint); color: var(--sage-dark); }

/* 弹窗 */
.mask { position: fixed; inset: 0; background: rgba(30,32,24,.45); z-index: 300; opacity: 0; pointer-events: none; transition: opacity .25s; }
.mask.show { opacity: 1; pointer-events: auto; }
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 301;
  background: var(--cream); border-radius: 56rpx 56rpx 0 0;
  padding: 32rpx 40rpx calc(56rpx + env(safe-area-inset-bottom));
  transform: translateY(100%); transition: transform .3s cubic-bezier(.2,.9,.3,1);
  max-height: 82vh; overflow-y: auto;
}
.sheet.show { transform: translateY(0); }
.sh-handle { width: 72rpx; height: 8rpx; border-radius: 4rpx; background: var(--paper-dark); margin: 0 auto 24rpx; }
.dks-kicker { font-size: 24rpx; font-weight: 700; color: var(--sage-dark); }
.dks-title { font-size: 38rpx; font-weight: 700; margin: 12rpx 0 20rpx; }
.dks-body { font-size: 30rpx; color: var(--ink); line-height: 1.75; white-space: pre-line; }
.dks-src { font-size: 22rpx; color: var(--ink-soft); margin-top: 28rpx; line-height: 1.5; }
.sh-actions { display: flex; gap: 20rpx; margin-top: 32rpx; }
.sh-actions .btn { flex: 1; }
