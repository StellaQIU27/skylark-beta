.page { min-height: 100vh; background: var(--cream); padding: 24rpx 32rpx 0; }
.row { display: flex; align-items: center; gap: 22rpx; padding: 24rpx 12rpx; border-bottom: 2rpx solid var(--beige-border); }
.av { width: 80rpx; height: 80rpx; border-radius: 50%; background: var(--sage-dark); color: #fff; font-weight: 700; font-size: 30rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.bd { flex: 1; min-width: 0; }
.n { font-size: 29rpx; font-weight: 600; }
.tag { font-size: 22rpx; color: var(--sage-dark); }
